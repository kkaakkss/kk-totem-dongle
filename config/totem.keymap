#define QWERTY 0
#define NAV    1
#define NUM    2
#define OSL    3
#define PINKY  4

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/*
 * KEYBALL39 -> TOTEM layer port
 *
 * KEYBALL39 layers 0 / 1 / 2 / 3 / 7
 *       TOTEM layers 0 / 1 / 2 / 3 / 4
 *
 * TOTEM's two outer bottom-row keys are LSHIFT / RSHIFT.
 * The six thumb keys follow the supplied layout image:
 *
 *   left : LT(NAV, SPACE), LCTRL, LALT
 *   right: SPACE, CAPSLOCK, LT(NUM, SPACE)
 */

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        hrm_L: homerow_left {
            compatible = "zmk,behavior-hold-tap";
            label = "Homerow_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <
                5 6 7 8 9
                15 16 17 18 19
                26 27 28 29 30 31
                35 36 37
            >;
        };

        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "Hold_Tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "balanced";
        };

        hrm_r: homerow_right {
            compatible = "zmk,behavior-hold-tap";
            label = "Homerow_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <
                0 1 2 3 4
                10 11 12 13 14
                20 21 22 23 24 25
                32 33 34
            >;
        };

        alt_q_1: alt_q_1 {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_Q_1";
            bindings = <&kp Q>, <&kp NUMBER_1>;

            #binding-cells = <0>;
            mods = <MOD_LALT>;
            keep-mods = <MOD_LALT>;
        };

        alt_w_2: alt_w_2 {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_W_2";
            bindings = <&kp W>, <&kp NUMBER_2>;

            #binding-cells = <0>;
            mods = <MOD_LALT>;
            keep-mods = <MOD_LALT>;
        };

        alt_e_3: alt_e_3 {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_E_3";
            bindings = <&kp E>, <&kp NUMBER_3>;

            #binding-cells = <0>;
            mods = <MOD_LALT>;
            keep-mods = <MOD_LALT>;
        };

        alt_r_4: alt_r_4 {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_R_4";
            bindings = <&kp R>, <&kp NUMBER_4>;

            #binding-cells = <0>;
            mods = <MOD_LALT>;
            keep-mods = <MOD_LALT>;
        };

        alt_t_5: alt_t_5 {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_T_5";
            bindings = <&kp T>, <&kp NUMBER_5>;

            #binding-cells = <0>;
            mods = <MOD_LALT>;
            keep-mods = <MOD_LALT>;
        };

        space_to0: space_to0 {
            compatible = "zmk,behavior-tap-dance";
            label = "SPACE_TO0";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&to 0>;
        };

        space_shift: space_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
        };

        dtap_to_lay2: dtap_to_lay2 {
            compatible = "zmk,behavior-tap-dance";
            label = "DTAP_TO_LAY2";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&tog 2>;
        };

        ctrl_guard_alt_e: ctrl_guard_alt_e {
            compatible = "zmk,behavior-mod-morph";
            label = "CTRL_GUARD_ALT_E";
            bindings = <&alt_e_3>, <&kp E>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };

        ctrl_guard_alt_q: ctrl_guard_alt_q {
            compatible = "zmk,behavior-mod-morph";
            label = "CTRL_GUARD_ALT_Q";
            bindings = <&alt_q_1>, <&kp Q>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };

        ctrl_guard_alt_w: ctrl_guard_alt_w {
            compatible = "zmk,behavior-mod-morph";
            label = "CTRL_GUARD_ALT_W";
            bindings = <&alt_w_2>, <&kp W>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };

        mo3_to2_outshell: mo3_to2_outshell {
            compatible = "zmk,behavior-tap-dance";
            label = "MO3_TO2_OUTSHELL";
            #binding-cells = <0>;
            bindings = <&mo3_to2_in 3 0>, <&to 2>;
        };

        mo3_to2_in: mo3_to2_in {
            compatible = "zmk,behavior-hold-tap";
            label = "MO3_TO2_IN";
            bindings = <&mo>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };

        n_b: n_b {
            compatible = "zmk,behavior-tap-dance";
            label = "N_B";
            #binding-cells = <0>;
            bindings = <&kp N>, <&kp B>;
        };

        dot_to0: dot_to0 {
            compatible = "zmk,behavior-tap-dance";
            label = "DOT_TO0";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&to 0>;
        };

        b_n: b_n {
            compatible = "zmk,behavior-tap-dance";
            label = "B_N";
            #binding-cells = <0>;
            bindings = <&kp B>, <&kp N>;
        };
    };

    macros {
        Hiragana: Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "HIRAGANA";
        };

        bt_in_out: bluetooth {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &out OUT_TOG>;
            label = "BLUETOOTH";
        };
    };

    combos {
        compatible = "zmk,combos";

        enter_r {
            bindings = <&kp ENTER>;
            key-positions = <16 17>;
            layers = <0>;
        };

        enter_l {
            bindings = <&kp ENTER>;
            key-positions = <12 13>;
            layers = <0>;
        };

        del_r {
            bindings = <&kp DELETE>;
            key-positions = <7 8>;
            layers = <0 2>;
        };

        del_l {
            bindings = <&kp DELETE>;
            key-positions = <23 24>;
            layers = <0>;
        };

        bsp_r {
            bindings = <&kp BACKSPACE>;
            key-positions = <6 7>;
            layers = <0 2>;
        };

        bsp_l {
            bindings = <&kp BACKSPACE>;
            key-positions = <22 23>;
            layers = <0>;
        };

        caps_combo {
            bindings = <&kp CAPSLOCK>;
            key-positions = <21 22>;
            layers = <0>;
        };

        esc_combo {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <0>;
        };

        ralt_combo {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <16 18>;
            layers = <0>;
        };

        osl_combo {
            bindings = <&sl 4>;
            key-positions = <11 12 13>;
            layers = <0>;
        };

        shift_home {
            bindings = <&kp LS(HOME)>;
            key-positions = <6 7>;
            layers = <1>;
        };

        shift_end {
            bindings = <&kp LS(END)>;
            key-positions = <7 8>;
            layers = <1>;
        };

        ctrl_left {
            bindings = <&kp LC(LEFT_ARROW)>;
            key-positions = <16 17>;
            layers = <1>;
        };

        ctrl_right {
            bindings = <&kp LC(RIGHT)>;
            key-positions = <17 18>;
            layers = <1>;
        };

        space_combo {
            bindings = <&kp SPACE>;
            key-positions = <24 25>;
            layers = <0>;
        };

        tab_combo {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
            layers = <0 5>;
        };

        esc2_combo {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
            layers = <0 5>;
        };

        minus_underscore {
            bindings = <&kp MINUS>;
            key-positions = <27 28>;
            layers = <0>;
        };

        quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <18 19>;
            layers = <0>;
        };

        dtap_to_l2 {
            bindings = <&dtap_to_lay2>;
            key-positions = <11 13>;
            layers = <0>;
        };

        kp {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <3 4>;
        };

        bra_R {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <5 6>;
        };

        BKT_L {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <13 14>;
        };

        BKT_R {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <15 16>;
        };

        gui_l {
            bindings = <&kp LG(L)>;
            key-positions = <1 2 3>;
            layers = <0>;
        };

        shift_home_l2 {
            bindings = <&kp LS(HOME)>;
            key-positions = <1 2>;
            layers = <2>;
        };

        shift_end_l2 {
            bindings = <&kp LS(END)>;
            key-positions = <2 3>;
            layers = <2>;
        };

        ctrl_left_l2 {
            bindings = <&kp LC(LEFT)>;
            key-positions = <11 12>;
            layers = <2>;
        };

        ctrl_righr_l2 {
            bindings = <&kp LC(RIGHT)>;
            key-positions = <12 13>;
            layers = <2>;
        };

        grave_R {
            bindings = <&kp GRAVE>;
            key-positions = <28 29>;
            layers = <0>;
        };

        backslash {
            bindings = <&kp BSLH>;
            key-positions = <29 30>;
            layers = <0>;
        };

        equal_plus {
            bindings = <&kp EQUAL>;
            key-positions = <26 27>;
            layers = <0>;
        };

        ssang_siut {
            bindings = <&kp LS(T)>;
            key-positions = <3 2>;
        };

        dtap_to_l0 {
            bindings = <&to 0>;
            key-positions = <11 13>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWERTY";
            bindings = <
                      &ctrl_guard_alt_q  &ctrl_guard_alt_w  &ctrl_guard_alt_e  &alt_r_4        &alt_t_5       &kp Y                          &kp U                      &kp I              &kp O    &kp P
                      &kp A              &kp S              &hrm_L LSHFT D     &hrm_L LSHFT F  &kp G          &kp H                          &hrm_r LSHIFT J            &hrm_r LSHFT K     &kp L    &kp SEMICOLON
&mt LEFT_SHIFT LS(T)  &kp Z              &kp X              &kp C              &kp V           &b_n           &n_b                           &kp M                      &kp COMMA          &kp DOT  &ht QUESTION SLASH  &mt RIGHT_SHIFT QUESTION
                                                            &kp LCTRL          &kp LALT        &lt 1 SPACE    &space_shift LEFT_SHIFT SPACE  &space_shift LSHIFT SPACE  &mo3_to2_outshell
            >;
        };

        f_grave_layer {
            label = "`\f & navi";
            bindings = <
        &kp GRAVE             &kp F2     &kp F3         &kp F4             &kp F5       &none   &kp HOME        &kp UP_ARROW   &kp END    &ht LC(HOME) PG_UP
        &kp NON_US_BACKSLASH  &kp LC(S)  &kp LC(PG_UP)  &kp LC(PAGE_DOWN)  &none        &none   &kp LEFT_ARROW  &kp DOWN       &kp RIGHT  &ht LC(END) PAGE_DOWN
&trans  &kp LC(Z)             &kp LC(X)  &kp LC(C)      &kp LC(V)          &kp LC(B)    &none   &none           &kp LS(ENTER)  &none      &none                  &trans
                                         &trans         &trans             &trans       &trans  &trans          &trans
            >;
        };

        navi_num {
            label = "navi, num";
            bindings = <
        &ht LC(HOME) PG_UP  &kp HOME  &kp UP         &kp END    &bt_in_out    &kp PLUS   &kp N7        &kp N8    &kp N9  &kp ASTERISK
        &ht LC(END) PG_DN   &kp LEFT  &kp DOWN       &kp RIGHT  &trans        &kp MINUS  &kp N4        &kp N5    &kp N6  &kp SLASH
&trans  &trans              &trans    &kp LS(ENTER)  &trans     &trans        &kp EQUAL  &kp N1        &kp N2    &kp N3  &kp COMMA     &trans
                                      &trans         &trans     &trans        &trans     &kp NUMBER_0  &dot_to0
            >;
        };

        num_navi_layer {
            label = "num, navi";
            bindings = <
        &kp ASTERISK  &kp N7  &kp N8   &kp N9  &kp PLUS     &none   &kp HOME  &kp UP         &kp END    &ht LC(HOME) PG_UP
        &kp SLASH     &kp N4  &kp N5   &kp N6  &kp MINUS    &none   &kp LEFT  &kp DOWN       &kp RIGHT  &ht LC(END) PAGE_DOWN
&trans  &kp COMMA     &kp N1  &kp N2   &kp N3  &kp EQUAL    &none   &trans    &kp LS(ENTER)  &trans     &trans                 &trans
                              &kp DOT  &kp N0  &trans       &trans  &trans    &trans
            >;
        };

        osl_layer {
            label = "OSL";
            bindings = <
            &kp LC(GRAVE)  &kp F23           &kp F22           &kp LG(R)         &kp LS(F2)      &trans  &trans  &trans  &trans  &trans
            &kp LC(GRAVE)  &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LS(F3)      &trans  &trans  &trans  &trans  &trans
&bt_in_out  &kp F21        &kp F19           &kp F20           &kp F18           &kp LG(HOME)    &trans  &trans  &trans  &trans  &trans  &trans
                                             &trans            &trans            &trans          &trans  &trans  &trans
            >;
        };

        pinky_layer_nouse {
            label = "PINKY";
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans         &trans     &trans
        &trans  &kp Q   &kp A   &kp Z   &trans    &trans  &kp P   &kp SEMICOLON  &kp SLASH  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans         &trans     &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
